Proceso sin_titulo
	definir kilometros, gasolina, total_de_gastados Como Real;
	escribir "Digita la cantidad de kilometros recorridos";
	leer kilometros;
	escribir "Digita la cantidad de gasolina que tenias antes de conducir";
	leer gasolina ;
	total_de_gastados<- gasolina/kilometros;
	escribir " el consumo de gasolina fue ", total_de_gastados; 
FinProceso
